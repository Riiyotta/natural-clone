        "eyebrow": "Values",
        "heading": "Anchored in strong beliefs and principles",
        "items": [
          {
            "number": "1",
            "headline": "We're playing to win",
            "description": "We're not in this to be runner-up, we're playing to win. We treat our company like a sports team, not a family."
          },
          {
            "number": "2",
            "headline": "Slope and intellect over everything",
            "description": "You\u2019re smart, learn quickly, and care deeply about your work. We hire people who want to be the best at what they do."
          },
          {
            "number": "3",
            "headline": "Every detail matters",
            "description": "Everything from API design to email signatures to divider weight matters. An unintentional decision is a poor one."
          },
          {
            "number": "4",
            "headline": "In-person, in-office culture",
            "description": "Speed and team cohesion lead to success. We're in-person, in-office, in San Francisco, six days per week."
          },
          {
            "number": "5",
            "headline": "No ego, the right ideas prevail",
            "description": "It's not about seniority or protecting ego. We debate openly and push towards intellectual truth."
          },
          {
            "number": "6",
            "headline": "Do the best work of your career",
            "description": "You should be excited to put your name on your work. This should be the best work you've ever done."
          }
        ]
