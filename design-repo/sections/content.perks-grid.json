{
  "id": "content.perks-grid",
  "category": "content",
  "name": "Perks grid",
  "purpose": "A partner-logo row over a multi-row 3-column grid of benefit line items. The /careers 'Perks' section.",
  "content": {
    "additionalProperties": false,
    "properties": {
      "eyebrow": { "type": "string", "maxWords": 3 },
