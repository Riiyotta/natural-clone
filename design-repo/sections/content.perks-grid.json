      },
      "perks": {
        "type": "array", "minItems": 3, "maxItems": 18,
        "items": { "additionalProperties": false, "properties": { "title": { "type": "string", "maxWords": 6 }, "subtitle": { "type": "string", "maxWords": 12 } }, "required": ["title", "subtitle"] }
      }
    },
    "required": ["eyebrow", "heading", "intro", "partners", "perks"]
  },
  "constraints": { "maxPerPage": 1, "mustNotBeFirst": true, "mustNotBeLast": true },
  "motion": { "allowed": ["none"], "reducedMotionFallback": "none" },
  "responsive": { "mobile": { "columns": 1, "gap": "space.40" }, "desktop": { "columns": 3, "columnGap": "space.120", "rowGap": "space.80" } },
  "assetPolicy": "partners[].logo uses logo.partner, which is must-not-fabricate — these are real third-party trademarks. A generated page for another brand should set partners to an empty array (minItems is 0 for exactly this reason) rather than substituting other companies' marks.",
  "measuredFrom": "src/pages/Careers.jsx:283-316"
