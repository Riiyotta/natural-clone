{
  "id": "interactive.tab-stage",
  "category": "interactive",
  "name": "Tabbed visual stage",
  "purpose": "A photographic stage with a floating card that crossfades as the reader picks a tab, plus a CTA row. The homepage's 'Flows' section.",
  "content": {
    "additionalProperties": false,
    "properties": {
      "eyebrow": { "type": "string", "maxWords": 3 },
      "heading": { "type": "string", "maxWords": 10 },
      "backgroundAsset": { "type": "assetRef", "assetRole": "photo.section-graphic" },
      "tabs": {
        "type": "array", "minItems": 4, "maxItems": 4,
        "items": {
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "maxWords": 4 },
            "body":  { "type": "string", "maxWords": 16 },
            "image": { "type": "assetRef", "assetRole": "photo.section-graphic" }
          },
          "required": ["label", "body", "image"]
        }
      },
      "primaryCta":   { "$ref": "primitives/button.pill-primary" },
      "secondaryCta": { "$ref": "primitives/button.pill-ghost" }
    },
    "required": ["eyebrow", "heading", "backgroundAsset", "tabs", "primaryCta", "secondaryCta"]
  },
  "constraints": { "onePerPage": true, "maxPerPage": 1, "mustNotBeFirst": true, "mustNotBeLast": true },
  "motion": { "allowed": ["opacity-crossfade"], "reducedMotionFallback": "instant-swap", "detail": "All four tab images are always mounted and crossfade via opacity, 300ms ease-out — they are never swapped or unmounted. Only the active tab renders its body copy; inactive tab labels are text.tertiary." },
  "responsive": { "mobile": { "stageHeight": "400px", "tabLayout": "column, gap space.24" }, "desktop": { "stageHeight": "560px", "tabLayout": "row, gap space.40, equal flex" } },
  "accessibility": { "role": "tablist", "childRole": "tab", "ariaSelected": true },
  "measuredFrom": "src/components/Flows.jsx:54-127"
}
